FROM ubuntu:22.04

SHELL [ "/bin/bash", "-c" ]
# DEBIAN_FRONTEND=noninteractive: needed to sidestep interactivity in install
# of tzdata, which asks for time zone info
RUN apt-get update -y && \
    DEBIAN_FRONTEND=noninteractive \
    apt-get install -y autoconf \
                       automake \
                       build-essential \
                       clang-format \
                       cmake \
                       curl \
                       elpa-paredit \
                       emacs-nox \
                       gcovr \
                       git \
                       libboost-dev \
                       python3 \
                       python3-pip \
                       sbcl \
                       slime \
                       software-properties-common \
                       wget

RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/bin" sh
RUN /usr/bin/uv venv
RUN /usr/bin/uv pip install conan
